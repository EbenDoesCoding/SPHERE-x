#!/usrbon/env python3

"""
spherex.py -- SPHEREx image search, cutouts, reprojection and PNG frames (B1)

Reimplemented from IRSA's public "Spectral Image Cutouts" tutorial
(https://caltech-ipac.github.io/irsa-tutorials/spherex-cutouts, BSD-3-Clause).

One request (ra, dec, size) flows through:
  1. search_images()   IRSA TAP query            -> list[ImageRef]  (one per exposure)
  2. fetch_cutouts()   parallel download+retries -> list[Cutout]
  3. group_by_wavelength() + select_frames()
                       split frames into like-colour groups, choose what to show
  4. build_frames_from_cutouts()
                       reproject onto ONE common sky grid, shared stretch, PNGs

build_frames() runs all four steps and returns a JSON-ready dict (/frames).

STATUS: steps 1-2 ran against live IRSA (WISE 0855, detectors 2 and 5). Steps 3-4 are tested offline
(test_spherex_offline.py) on synthetic images and on the real detector-5 wavelengths/dates.
Anything marked UNVERIFIED must be checked before it is shown in the UI.

NOTE FOR B2: build_frames() is blocking and slow (the TAP query alone took ~20 s in
IRSA's tutorial). Declare the FastAPI route with plain `def`, not `async def`, so it
runs in a worker thread, and put your cache around it.
"""
from __future__ import annotations

import concurrent.futures
import http.client
import logging
import random
import re
import time
import urllib.error
import warnings
from collections import Counter, defaultdict
from dataclasses import dataclass
from pathlib import Path

import astropy.units as u
import numpy as np
from astropy.coordinates import SkyCoord
from astropy.io import fits
from astropy.time import Time
from astropy.utils.data import conf
from astropy.wcs import WCS
from astropy.wcs.utils import proj_plane_pixel_scales
from astroquery.ipac.irsa import Irsa
from PIL import Image
from reproject import reproject_interp

log = logging.getLogger("spherex")
# astropy repeats warnings about alternate WCSs on every SPHEREx file (as in the IRSA notebook).
logging.getLogger("astropy").setLevel(logging.ERROR)
# Reading SPHEREx files can exceed astropy's default timeout (IRSA notebook raises it too).
conf.remote_timeout = 120

# --------------------------------------------------------------------------- config
IRSA_BASE = "https://irsa.ipac.caltech.edu/"
MIN_SIZE_DEG = 0.01        # field of view limits (the FOV slider's range)
MAX_SIZE_DEG = 0.30        # larger = more pixels to download and reproject
MAX_CANDIDATES = 80        # cutouts downloaded per request (spread evenly over time)
MAX_FRAMES = 20            # frames returned to the frontend
GROUP_GAP_FRAC = 0.004     # new wavelength group when sorted neighbours differ by more than 0.4%.
GROUP_MAX_SPAN_FRAC = 0.006  # ...or when a group would span more than 0.6% (stops chaining).
                           # Both UNVERIFIED starting values, tuned on WISE 0855 / detector 5 only:
                           # within a step the scatter was <=0.14%, between steps >=0.8%.
EPOCH_GAP_DAYS = 10.0      # frames closer than this (chained) belong to one epoch (one survey visit)
BASELINE_BUCKET_DAYS = 30  # baselines within the same 30-day bucket count as a tie when ranking
MODES = ("best", "group", "stack", "all")
MAX_WORKERS = 10           # IRSA tutorial suggests 7-12 parallel requests
MAX_RETRIES = 3            # IRSA's tutorial saw transient failures on a noticeable share of cutouts
OVERSAMPLE = 2             # output pixels per native pixel (helps sub-pixel motion look smooth)
STRETCH_PERCENTILES = (1.0, 99.0)
BAD_FLAG_MASK = 0          # UNVERIFIED: which FLAGS bits mean "bad pixel". 0 = mask nothing, only report.
                           # Look the bit meanings up in the SPHEREx Explanatory Supplement, then set this.
TRANSIENT_ERRORS = (OSError, http.client.HTTPException)  # covers timeouts, resets, IncompleteRead


# --------------------------------------------------------------------------- errors
class SpherexError(Exception):
    """Base class. B2: map .code and str(exc) to the standard {error} response."""
    code = "spherex_error"


class BadRequest(SpherexError):
    code = "bad_request"          # -> HTTP 400


class NoCoverage(SpherexError):
    code = "no_coverage"          # -> HTTP 404 (valid request, no SPHEREx images there yet)


class UpstreamError(SpherexError):
    code = "upstream_error"       # -> HTTP 502 (IRSA failed or returned nothing usable)


# --------------------------------------------------------------------------- data types
@dataclass
class ImageRef:
    uri: str            # cutout URL for this exposure (center and size already in the URL)
    mjd: float          # observation time from the TAP table (time_bounds_lower; treated as MJD)
    detector: int | None
    release: str        # e.g. "qr3" / "dr1", parsed from the URL path
    file_id: str


@dataclass
class Cutout:
    ref: ImageRef
    image: np.ndarray           # IMAGE extension, float32
    flags: np.ndarray | None    # FLAGS extension
    wcs: WCS                    # sky WCS of this cutout's own pixels
    wavelength_um: float        # central wavelength at the target position (from WCS-WAVE)
    version: str                # processing VERSION from the primary header
    epoch: int = -1             # visit number, set by assign_epochs()


@dataclass
class WavelengthGroup:
    """Frames whose central wavelengths agree closely (one 'colour')."""
    id: int                     # stable: numbered by ascending wavelength
    wavelength_um: float | None
    cutouts: list               # sorted by time
    epochs: list                # global epoch ids present in this group
    baseline_days: float

    @property
    def n_frames(self) -> int:
        return len(self.cutouts)

    @property
    def n_epochs(self) -> int:
        return len(self.epochs)

    def summary(self, recommended: bool = False) -> dict:
        t = [c.ref.mjd for c in self.cutouts]
        return {
            "id": self.id,
            "wavelength_um": None if self.wavelength_um is None else round(self.wavelength_um, 4),
            "n_frames": self.n_frames,
            "n_epochs": self.n_epochs,
            "baseline_days": round(self.baseline_days, 1),
            "first_iso": Time(min(t), format="mjd").isot,
            "last_iso": Time(max(t), format="mjd").isot,
            "usable_for_motion": self.n_epochs >= 2,
            "recommended": recommended,
        }


# --------------------------------------------------------------------------- validation
def validate_request(ra, dec, size_deg, detector=None):
    """Return cleaned (ra, dec, size_deg, detector) or raise BadRequest."""
    try:
        ra, dec, size_deg = float(ra), float(dec), float(size_deg)
    except (TypeError, ValueError):
        raise BadRequest("ra, dec and size must be numbers") from None
    if not all(np.isfinite([ra, dec, size_deg])):
        raise BadRequest("ra, dec and size must be finite numbers")
    if not 0.0 <= ra <= 360.0:
        raise BadRequest("ra must be between 0 and 360 degrees")
    if not -90.0 <= dec <= 90.0:
        raise BadRequest("dec must be between -90 and 90 degrees")
    if not MIN_SIZE_DEG <= size_deg <= MAX_SIZE_DEG:
        raise BadRequest(f"size must be between {MIN_SIZE_DEG} and {MAX_SIZE_DEG} degrees")
    if detector is not None:
        try:
            detector = int(detector)
        except (TypeError, ValueError):
            raise BadRequest("detector must be an integer 1-6") from None
        if detector not in range(1, 7):
            raise BadRequest("detector must be between 1 and 6")
    return ra, dec, size_deg, detector


# --------------------------------------------------------------------------- 1. search
def _parse_detector(bandpass, uri) -> int | None:
    m = re.search(r"D(\d)$", str(bandpass)) if bandpass is not None else None
    if m is None:
        # UNVERIFIED fallback: IRSA's example file names end like "..._4D2_spx_..." for detector 2.
        m = re.search(r"\d+D(\d)_spx", uri)
    return int(m.group(1)) if m else None


def search_images(ra, dec, size_deg, detector=None) -> list[ImageRef]:
    """All SPHEREx exposures covering (ra, dec), oldest first.

    Uses the TAP query from IRSA's cutout tutorial. TAP sees new data right after the weekly
    ingestion (SIA lags ~1 day). The tutorial's release note: QR3 and DR1 supersede QR2, and the
    metadata tables already contain them, so no release name is hard-coded here.
    """
    ra, dec, size_deg, detector = validate_request(ra, dec, size_deg, detector)
    det_clause = f"AND p.energy_bandpassname = 'SPHEREx-D{detector}'" if detector else ""
    # `p.energy_bandpassname AS bandpass` in the SELECT is UNVERIFIED (the tutorial only uses it in WHERE).
    # If it errors on the first live run, delete it: the detector is then parsed from the file name.
    query = f"""
    SELECT
        '{IRSA_BASE}' || a.uri || '?center={ra:.8f},{dec:.8f}d&size={size_deg:.6g}' AS uri,
        p.time_bounds_lower,
        p.energy_bandpassname AS bandpass
    FROM spherex.artifact a
    JOIN spherex.plane p ON a.planeid = p.planeid
    WHERE 1 = CONTAINS(POINT('ICRS', {ra:.8f}, {dec:.8f}), p.poly)
        {det_clause}
    ORDER BY p.time_bounds_lower
    """
    t0 = time.time()
    try:
        table = Irsa.query_tap(query).to_table()
    except Exception as exc:  # network, TAP syntax, service down...
        raise UpstreamError(f"IRSA TAP query failed: {exc}") from exc
    log.info("TAP query: %d images in %.1f s", len(table), time.time() - t0)

    has_band = "bandpass" in table.colnames
    refs = []
    for row in table:
        mjd = float(row["time_bounds_lower"])
        if not np.isfinite(mjd):
            continue
        uri = str(row["uri"])
        rel = re.search(r"/spherex/([^/]+)/level2/", uri)
        refs.append(ImageRef(
            uri=uri,
            mjd=mjd,
            detector=_parse_detector(row["bandpass"] if has_band else None, uri),
            release=rel.group(1) if rel else "unknown",
            file_id=uri.split("?")[0].rsplit("/", 1)[-1],
        ))
    refs.sort(key=lambda r: r.mjd)
    return refs


# --------------------------------------------------------------------------- 2. cutouts
def _read_cutout(ref: ImageRef, coord: SkyCoord) -> Cutout:
    """Download one cutout. Mirrors process_cutout() in the IRSA notebook."""
    # HDUs: 0 primary (no data), then IMAGE, FLAGS, VARIANCE, ZODI, EPSF, WCS-WAVE.
    with fits.open(ref.uri, cache=False) as hdul:
        image_hdu = hdul["IMAGE"]
        header = image_hdu.header
        image = np.array(image_hdu.data, dtype=np.float32)   # native byte order, own memory
        try:
            flags = np.array(hdul["FLAGS"].data)
        except KeyError:
            flags = None

        spatial_wcs = WCS(header)
        x, y = spatial_wcs.world_to_pixel(coord)

        # Central wavelength at the target pixel (SPHEREx wavelength varies across each detector).
        spectral_wcs = WCS(header, fobj=hdul, key="W")
        spectral_wcs.sip = None
        wavelength, _bandwidth = spectral_wcs.pixel_to_world(x, y)
        wavelength_um = float(wavelength.to(u.micrometer).value)

        version = str(hdul[0].header.get("VERSION", ""))
    return Cutout(ref, image, flags, spatial_wcs, wavelength_um, version)


def fetch_cutout(ref: ImageRef, coord: SkyCoord, retries: int = MAX_RETRIES) -> Cutout | None:
    """One cutout with retries on transient errors. Returns None if it still fails."""
    for attempt in range(retries + 1):
        try:
            return _read_cutout(ref, coord)
        except TRANSIENT_ERRORS as exc:
            if isinstance(exc, urllib.error.HTTPError) and 400 <= exc.code < 500:
                log.warning("cutout %s: HTTP %s, not retrying", ref.file_id, exc.code)
                return None
            if attempt < retries:
                time.sleep(min(8.0, 2.0 ** attempt) * (0.5 + random.random()))
        except Exception as exc:  # corrupt file, missing extension... skip this frame only
            log.warning("cutout %s skipped: %r", ref.file_id, exc)
            return None
    log.warning("cutout %s failed after %d retries", ref.file_id, retries)
    return None


def fetch_cutouts(refs, coord, max_workers: int = MAX_WORKERS):
    """Download cutouts in parallel. Returns (cutouts, n_failed)."""
    with concurrent.futures.ThreadPoolExecutor(max_workers=max_workers) as pool:
        results = list(pool.map(lambda r: fetch_cutout(r, coord), refs))
    ok = [c for c in results if c is not None]
    return ok, len(refs) - len(ok)


def _even_subsample(items, n):
    if len(items) <= n:
        return list(items)
    idx = np.unique(np.linspace(0, len(items) - 1, n).round().astype(int))
    return [items[i] for i in idx]


# --------------------------------------------------------------------------- 3. wavelength groups
def assign_epochs(cutouts, gap_days: float = EPOCH_GAP_DAYS) -> int:
    """Label each cutout with an epoch (survey visit): frames chained by gaps < gap_days share one.
    Sets cutout.epoch in place and returns the number of epochs."""
    epoch, prev = -1, None
    for c in sorted(cutouts, key=lambda c: c.ref.mjd):
        if prev is None or c.ref.mjd - prev > gap_days:
            epoch += 1
        c.epoch, prev = epoch, c.ref.mjd
    return epoch + 1


def _split_wavelengths(by_wavelength, gap_frac, max_span_frac):
    """Cut the wavelength-sorted list wherever neighbours are far apart (relative gap) or the
    running group would get too wide. Following the gaps in the data, not a fixed window, is what
    lets this adapt to every detector."""
    groups, cur = [], [by_wavelength[0]]
    for c in by_wavelength[1:]:
        gap = (c.wavelength_um - cur[-1].wavelength_um) / cur[-1].wavelength_um
        span = (c.wavelength_um - cur[0].wavelength_um) / cur[0].wavelength_um
        if gap > gap_frac or span > max_span_frac:
            groups.append(cur)
            cur = [c]
        else:
            cur.append(c)
    groups.append(cur)
    return groups


def group_by_wavelength(cutouts, gap_frac=GROUP_GAP_FRAC, max_span_frac=GROUP_MAX_SPAN_FRAC,
                        epoch_gap_days=EPOCH_GAP_DAYS) -> list[WavelengthGroup]:
    """Split cutouts into like-colour groups and rank them for spotting motion.

    Ranking (best first): most distinct epochs, then longest time baseline (30-day buckets), then
    most frames, then shortest wavelength. groups[0] is the recommended group. Group ids are stable
    (ascending wavelength), so a frontend dropdown keeps its meaning when the ranking changes.
    Also sets .epoch on every cutout.
    """
    if not cutouts:
        return []
    assign_epochs(cutouts, epoch_gap_days)
    usable = sorted((c for c in cutouts if np.isfinite(c.wavelength_um) and c.wavelength_um > 0),
                    key=lambda c: c.wavelength_um)
    raw = _split_wavelengths(usable, gap_frac, max_span_frac) if usable else [list(cutouts)]

    groups = []
    for gid, members in enumerate(raw):
        members = sorted(members, key=lambda c: c.ref.mjd)
        t = [c.ref.mjd for c in members]
        groups.append(WavelengthGroup(
            id=gid,
            wavelength_um=float(np.median([c.wavelength_um for c in members])) if usable else None,
            cutouts=members,
            epochs=sorted({c.epoch for c in members}),
            baseline_days=max(t) - min(t),
        ))
    groups.sort(key=lambda g: (-g.n_epochs, -int(g.baseline_days // BASELINE_BUCKET_DAYS),
                               -g.n_frames, g.wavelength_um or 0.0))
    return groups


def select_frames(groups, cutouts, mode="best", group_id=None, max_frames=MAX_FRAMES):
    """Decide what goes to the viewer. Returns (frame_sets, selected_group_ids); every frame set
    becomes ONE output image (several members = averaged).

      best   the top-ranked group, one image per exposure
      group  the group with this group_id, one image per exposure
      stack  one image per epoch, averaging the frames of that epoch. With group_id: that group only.
             Without: the best group plus every group seen at exactly the same epochs, so each epoch
             is built from the same set of colours (a like-for-like series with better S/N)
      all    every frame, all colours mixed (colour changes can look like motion; label it!)
    """
    if mode not in MODES:
        raise BadRequest(f"mode must be one of {', '.join(MODES)}")
    if not groups:
        raise NoCoverage("no usable frames")
    if mode == "all":
        frames = sorted(cutouts, key=lambda c: c.ref.mjd)
        return [[c] for c in _even_subsample(frames, max_frames)], [g.id for g in groups]

    pick = None
    if group_id is not None or mode == "group":
        try:
            pick = next(g for g in groups if g.id == int(group_id))
        except (StopIteration, TypeError, ValueError):
            raise BadRequest(f"unknown group_id {group_id!r}; available: "
                             f"{sorted(g.id for g in groups)}") from None

    if mode == "stack":
        if pick is not None:
            chosen = [pick]
        else:
            same = set(groups[0].epochs)
            chosen = [g for g in groups if set(g.epochs) == same]
        by_epoch = defaultdict(list)
        for g in chosen:
            for c in g.cutouts:
                by_epoch[c.epoch].append(c)
        sets = [sorted(v, key=lambda c: c.ref.mjd) for _, v in sorted(by_epoch.items())]
        return sets, [g.id for g in chosen]

    g = pick or groups[0]
    return [[c] for c in _even_subsample(g.cutouts, max_frames)], [g.id]


# --------------------------------------------------------------------------- 4. reproject + PNG
def make_common_grid(ra, dec, size_deg, native_scale_arcsec, oversample=OVERSAMPLE):
    """One TAN grid centred on the target, north up, east left. Every frame is resampled onto it,
    so a star at a fixed sky position lands on the same pixel in every frame."""
    scale = native_scale_arcsec / oversample
    n = max(8, int(round(size_deg * 3600.0 / scale)))
    w = WCS(naxis=2)
    w.wcs.ctype = ["RA---TAN", "DEC--TAN"]
    w.wcs.crval = [ra, dec]
    w.wcs.crpix = [(n + 1) / 2.0, (n + 1) / 2.0]
    w.wcs.cdelt = [-scale / 3600.0, scale / 3600.0]
    return w, n, scale


def _reproject_one(c: Cutout, wcs_out, shape_out, bad_flag_mask):
    img = c.image.copy()
    if bad_flag_mask and c.flags is not None:
        img[(c.flags.astype(np.int64) & bad_flag_mask) != 0] = np.nan
    out, _footprint = reproject_interp((img, c.wcs), wcs_out, shape_out=shape_out, order="bilinear")
    return out.astype(np.float32)


def _to_uint8(arr, lo, hi, mode):
    x = (arr - lo) / (hi - lo) if hi > lo else np.zeros_like(arr)
    x = np.clip(np.nan_to_num(x, nan=0.0), 0.0, 1.0)   # NaN (no data) -> black
    if mode == "asinh":
        x = np.arcsinh(10.0 * x) / np.arcsinh(10.0)
    return (x * 255.0 + 0.5).astype(np.uint8)


def build_frames_from_cutouts(frame_sets, ra, dec, size_deg, out_dir, url_prefix="",
                              stretch="asinh", percentiles=STRETCH_PERCENTILES,
                              subtract_median=True, oversample=OVERSAMPLE,
                              bad_flag_mask=BAD_FLAG_MASK) -> dict:
    """Reproject onto one grid, apply ONE shared stretch, write PNGs, return the JSON-ready dict.
    Pure function of its inputs (no network), so it is testable offline.

    frame_sets: list whose items are a Cutout (one image) or a list of Cutouts (averaged into one
    image, e.g. all frames of one epoch). select_frames() produces this.
    subtract_median: removes each frame's background level before averaging and stretching.
    UNVERIFIED whether SPHEREx IMAGE data is already background-subtracted; check the docs.
    """
    sets = [[s] if isinstance(s, Cutout) else list(s) for s in frame_sets]
    sets = [s for s in sets if s]
    if not sets:
        raise NoCoverage("no usable frames")
    out_dir = Path(out_dir)
    out_dir.mkdir(parents=True, exist_ok=True)

    everything = [c for s in sets for c in s]
    native = float(np.median([np.mean(proj_plane_pixel_scales(c.wcs)) for c in everything])) * 3600.0
    wcs_out, n, scale = make_common_grid(ra, dec, size_deg, native, oversample)

    arrays = []
    for members in sets:
        layers = []
        for c in members:
            arr = _reproject_one(c, wcs_out, (n, n), bad_flag_mask)
            if subtract_median and np.isfinite(arr).any():
                arr = arr - np.nanmedian(arr)
            layers.append(arr)
        with warnings.catch_warnings():
            warnings.simplefilter("ignore", RuntimeWarning)   # all-NaN pixels -> NaN, not a warning
            arrays.append(np.nanmean(np.stack(layers), axis=0).astype(np.float32))

    stack = np.stack(arrays)
    finite = stack[np.isfinite(stack)]
    if finite.size == 0:
        raise UpstreamError("all reprojected frames are empty (target outside every cutout?)")
    lo, hi = (float(v) for v in np.percentile(finite, percentiles))

    frames = []
    for i, (members, arr) in enumerate(zip(sets, arrays)):
        mjd = float(np.mean([c.ref.mjd for c in members]))
        wls = [c.wavelength_um for c in members if np.isfinite(c.wavelength_um)]
        det = members[0].ref.detector
        flag_vals = [float(np.mean(c.flags != 0)) for c in members if c.flags is not None]
        png = _to_uint8(arr, lo, hi, stretch)
        name = f"{i:02d}_D{det or 0}_{mjd:.4f}.png"
        Image.fromarray(np.flipud(png), mode="L").save(out_dir / name, optimize=True)  # north up
        frames.append({
            "index": i,
            "t_mjd": round(mjd, 5),
            "t_iso": Time(mjd, format="mjd").isot,
            "epoch": members[0].epoch,
            "detector": det,
            "wavelength_um": round(float(np.mean(wls)), 4) if wls else None,
            "n_stacked": len(members),
            "version": ",".join(sorted({c.version for c in members})),
            "release": ",".join(sorted({c.ref.release for c in members})),
            "file_id": members[0].ref.file_id,
            "file_ids": [c.ref.file_id for c in members],
            "image_url": f"{url_prefix.rstrip('/')}/{name}" if url_prefix else name,
            "valid_frac": round(float(np.isfinite(arr).mean()), 4),
            "flagged_frac": round(float(np.mean(flag_vals)), 4) if flag_vals else None,
        })

    return {
        "request": {"ra": ra, "dec": dec, "size_deg": size_deg},
        "grid": {
            "width": n, "height": n,
            "pixel_scale_arcsec": round(scale, 4),
            "native_pixel_scale_arcsec": round(native, 4),
            "target_xy": [(n - 1) / 2.0, (n - 1) / 2.0],   # 0-based, origin top-left, y down
            "orientation": "north up, east left",
            "wcs": {"ctype": list(wcs_out.wcs.ctype), "crval": list(wcs_out.wcs.crval),
                    "crpix": list(wcs_out.wcs.crpix), "cdelt": list(wcs_out.wcs.cdelt)},
        },
        "stretch": {"mode": stretch, "lo": lo, "hi": hi, "percentiles": list(percentiles),
                    "subtract_median": subtract_median},
        "frames": frames,
        "meta": {"n_used": len(frames)},
    }


# --------------------------------------------------------------------------- orchestrator
def build_frames(ra, dec, size_deg=0.05, detector=None, out_dir="static/frames/tmp",
                 url_prefix="/static/frames/tmp", max_frames=MAX_FRAMES,
                 mode="best", group_id=None, **build_kw) -> dict:
    """Everything for /frames. Raises BadRequest / NoCoverage / UpstreamError.
    mode / group_id: see select_frames(). The response lists every wavelength group in
    meta.groups so the frontend can offer a choice."""
    t0 = time.time()
    ra, dec, size_deg, detector = validate_request(ra, dec, size_deg, detector)
    if mode not in MODES:
        raise BadRequest(f"mode must be one of {', '.join(MODES)}")

    refs = search_images(ra, dec, size_deg, detector)
    if not refs:
        raise NoCoverage("SPHEREx has no images covering this position yet")

    counts = Counter(r.detector for r in refs if r.detector is not None)
    chosen_det = detector or (counts.most_common(1)[0][0] if counts else None)
    if chosen_det is not None:
        refs = [r for r in refs if r.detector == chosen_det]
    n_found = len(refs)

    candidates = _even_subsample(refs, MAX_CANDIDATES)
    coord = SkyCoord(ra * u.deg, dec * u.deg, frame="icrs")
    cutouts, n_failed = fetch_cutouts(candidates, coord)
    if not cutouts:
        raise UpstreamError("every cutout download failed; IRSA may be busy, try again")

    groups = group_by_wavelength(cutouts)
    frame_sets, selected = select_frames(groups, cutouts, mode, group_id, max_frames)
    result = build_frames_from_cutouts(frame_sets, ra, dec, size_deg, out_dir, url_prefix, **build_kw)

    warnings_out = []
    if mode == "all":
        warnings_out.append("mode 'all' mixes wavelengths: brightness changes may be colour, not motion")
    if len({f["epoch"] for f in result["frames"]}) < 2:
        warnings_out.append("fewer than 2 epochs in this selection: motion cannot be assessed")
    result["meta"].update({
        "mode": mode,
        "selected_groups": selected,
        "groups": [g.summary(recommended=(k == 0)) for k, g in enumerate(groups)],
        "warnings": warnings_out,
        "detector": chosen_det,
        "detectors_available": {str(k): v for k, v in sorted(counts.items())},
        "n_found": n_found,
        "n_candidates": len(candidates),
        "n_downloaded": len(cutouts),
        "n_failed": n_failed,
        "elapsed_s": round(time.time() - t0, 1),
    })
    return result


# --------------------------------------------------------------------------- manual test
if __name__ == "__main__":
    import argparse
    import json

    ap = argparse.ArgumentParser(description="Run the SPHEREx pipeline for one position.")
    ap.add_argument("--ra", type=float, default=None)
    ap.add_argument("--dec", type=float, default=None)
    ap.add_argument("--size", type=float, default=0.05, help="field of view in degrees")
    ap.add_argument("--detector", type=int, default=None, help="1-6 (default: most images)")
    ap.add_argument("--mode", default="best", choices=MODES)
    ap.add_argument("--group", type=int, default=None, help="wavelength group id (see the table)")
    ap.add_argument("--out", default="static/frames/test")
    args = ap.parse_args()
    logging.basicConfig(level=logging.INFO)

    if args.ra is None or args.dec is None:   # default target: WISE 0855 (coordinates from the brief)
        sc = SkyCoord("08h55m10.831s", "-07d14m42.53s", frame="icrs")
        args.ra, args.dec = sc.ra.deg, sc.dec.deg

    res = build_frames(args.ra, args.dec, args.size, args.detector, args.out, args.out,
                       mode=args.mode, group_id=args.group)
    meta = dict(res["meta"])
    groups = meta.pop("groups")
    print(json.dumps(meta, indent=2))
    print("\nwavelength groups (best first):")
    for g in groups:
        star = "*" if g["recommended"] else " "
        print(f" {star} id={g['id']}  {g['wavelength_um']} um  {g['n_frames']} frames  "
              f"{g['n_epochs']} epochs  {g['baseline_days']} d  {g['first_iso'][:10]} -> {g['last_iso'][:10]}")
    print("\nframes written:")
    for f in res["frames"]:
        print(f["t_iso"], f"D{f['detector']}", f"{f['wavelength_um']} um", f"x{f['n_stacked']}",
              f"epoch {f['epoch']}", f["image_url"])
